# ============================================================================
#  Incident Response On-Call Agent — configuration
# ============================================================================
#
#  HOW TO USE THIS FILE
#  --------------------
#  1. Make a copy of this file and name the copy  .env   (same folder)
#       Windows PowerShell:   Copy-Item .env.example .env
#       macOS / Linux:        cp .env.example .env
#  2. Open the new .env file in any text editor.
#  3. Fill in the one required value (GROQ_API_KEY) — everything else can
#     stay exactly as it is for a first run.
#  4. Save the file. Done.
#
#  IMPORTANT: never commit the .env file to Git. It holds your secret key.
#  The .gitignore file already blocks it — keep it that way.
#
#  FORMAT RULES
#  ------------
#    • One setting per line.
#    • No spaces around the  =  sign.
#    • Everything after a  #  is a comment and is ignored.
#    • A blank value means "not set / use the built-in default".
# ============================================================================


# ---------------------------------------------------------------------------
#  ★ REQUIRED — you must fill this in
# ---------------------------------------------------------------------------

# Your secret API key from  https://console.groq.com/keys
# Starts with  gsk_  followed by a long string. Keep it secret!
GROQ_API_KEY=


# ---------------------------------------------------------------------------
#  ★ RECOMMENDED — leave these alone for a first run
# ---------------------------------------------------------------------------

# Which "brain" makes the incident decisions:
#     groq  = real AI via Groq cloud        (needs GROQ_API_KEY above)
#     mock  = built-in pretend logic        (works offline, no key needed)
#     laya  = optional typed model          (needs requirements-laya.txt)
DECISION_PROVIDER=groq

# Which Groq model to use.
#   Verified working:  openai/gpt-oss-120b
GROQ_MODEL=openai/gpt-oss-120b

# How long to wait (in seconds) for Groq to answer before giving up.
GROQ_TIMEOUT_SECONDS=20

# Where the Redis message bus lives.
#   Default matches the Docker command in the README:
#       docker run --name incident-redis -p 6379:6379 -d redis:7-alpine
REDIS_URL=redis://localhost:6379

# How the human-approval gate behaves:
#     manual = pause and ask a human before fixing anything  (SAFE — recommended)
#     auto   = approve automatically                        (demo only, no safety net)
#     deny   = never approve, always report only            (safest)
APPROVAL_MODE=manual

# If the human is asked in a terminal, how many seconds to wait before
# giving up and offering the approval buttons on the web dashboard instead.
# Leave blank to use the default of 30. (Clamped between 1 and 600.)
APPROVAL_INPUT_TIMEOUT=


# ---------------------------------------------------------------------------
#  OPTIONAL — safe to leave blank. Only needed for extra features.
# ---------------------------------------------------------------------------

# --- Local, offline alternative brain (Ollama) -----------------------------
# Only used if you install Ollama yourself. Not required.
OLLAMA_MODEL=mistral

# Set to 1 to force the built-in pretend LLM instead of a real one.
# Handy for offline demos. Leave blank to use your real setup.
USE_MOCK_LLM=


# --- LangSmith tracing (history of every agent run, viewed in a browser) ---
# Free tier available at  https://smith.langchain.com
# Leave both blank to turn tracing off. The app runs fine without them.
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=incident-agent


# --- Where local data is stored --------------------------------------------
# You normally never change these. Delete the folders to start fresh.
CHROMA_DB_PATH=.chromadb
MEMORY_DB_PATH=.chromadb_memory
RUNBOOKS_DIR=runbooks


# --- OPTIONAL real-world integrations --------------------------------------
# Everything below is SIMULATED by default. The app works without any of
# these — they are only here so you can wire up real services later.
# Leave them blank unless you know you need them.

PAGERDUTY_API_KEY=

SLACK_BOT_TOKEN=

JIRA_URL=
JIRA_TOKEN=


# --- OPTIONAL metrics ------------------------------------------------------
# Only used by the metrics helper. The app works without a Prometheus server.
PROMETHEUS_URL=http://localhost:9090


# --- OPTIONAL performance tuning (laya provider only) ----------------------
# Most people can ignore this section completely.
LAYA_TORCH_THREADS=0
LAYA_MAX_LEN=
LAYA_HEAD_MAX_LEN=


# ============================================================================
#  MINIMUM WORKING EXAMPLE
# ============================================================================
#  If you just want to see it run, this is all you actually need:
#
#      GROQ_API_KEY=your_key_here_goes_here
#      DECISION_PROVIDER=groq
#      GROQ_MODEL=openai/gpt-oss-120b
#      REDIS_URL=redis://localhost:6379
#      APPROVAL_MODE=manual
#
#  No Groq key at all? Use the offline demo instead — zero setup:
#
#      DECISION_PROVIDER=mock
#      USE_MOCK_LLM=1
#      REDIS_URL=redis://localhost:6379
#      APPROVAL_MODE=manual
# ============================================================================
